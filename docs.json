{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Voxys Connect Developer Docs",
  "description": "Official developer documentation for Voxys Connect - the omnichannel CPaaS platform for MENA businesses. Learn about our APIs and integrations.",
  "logo": {
    "dark": "/logo/dark.png",
    "light": "/logo/light.png"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#00B0D4",
    "light": "#33C4E0",
    "dark": "#008BA8"
  },
