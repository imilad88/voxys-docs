    "/api/v1/accounts/{account_id}/billing/embedded_commerce_session": {
      "post": {
        "tags": [
          "Billing"
        ],
        "operationId": "embeddedCommerceSession",
        "summary": "Embedded session for a commerce platform",
        "description": "Embedded card session to activate a commerce platform (requires e-commerce add-on).",
