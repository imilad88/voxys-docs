{
  "openapi": "3.1.0",
  "info": {
    "title": "Voxys Connect - Billing APIs",
    "description": "Subscription, add-ons, packs, commerce platforms, WhatsApp credits and MyFatoorah payment sessions (embedded card + hosted product links).",
    "version": "1.0.0",
    "contact": {
      "email": "support@voxys.ai"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "https://connect.voxys.ai"
    }
  ],
  "x-tagGroups": [
